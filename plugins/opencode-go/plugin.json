{
  "schemaVersion": 1,
  "id": "opencode-go",
  "name": "OpenCode Go",
  "version": "0.1.0",
  "entry": "plugin.js",
  "icon": "icon.svg",
  "brandColor": "#000000",
  "detect": [
    { "file": "~/.config/usagepal/opencode-go.json" },
    { "file": "~/.local/share/opencode/auth.json" },
    { "env": "OPENCODE_API_KEY" }
  ],
  "links": [
    {
      "label": "Console",
      "url": "https://opencode.ai/auth"
    },
    {
      "label": "Docs",
      "url": "https://opencode.ai/docs/go/"
    }
  ],
  "lines": [
    {
      "type": "progress",
      "label": "Session",
      "scope": "overview",
      "primaryOrder": 1
    },
    {
      "type": "progress",
      "label": "Weekly",
      "scope": "overview",
      "period": "weekly"
    },
    {
      "type": "progress",
      "label": "Monthly",
      "scope": "overview",
      "escalateAtPercent": 98
    }
  ]
}
